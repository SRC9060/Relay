# Relay Server Environment Configuration (Backend / Render)
PORT=5000
NODE_ENV=production
# Optional: Allowed frontend origin for CORS (e.g. https://relay-client.vercel.app)
CLIENT_URL=

# Google Gemini API Configuration (Server-side only)
# To enable live LLM classification, summarization, and reply drafting, set your Gemini API key:
GEMINI_API_KEY=
# Optional: specify model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Relay Client Environment Configuration (Frontend / Vercel)
# Set to your deployed Render backend URL (e.g. https://relay-server.onrender.com)
VITE_API_URL=
